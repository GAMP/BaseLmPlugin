<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<Product>BaseLmPlugin</Product>
		<Description>Basic license management functionality plugin.</Description>
		<Company>NET Projects</Company>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWpf>true</UseWpf>
		<NoWarn>1591;1570;1573;0612</NoWarn>
		<Optimize>true</Optimize>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Configurations>Debug;Release</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Version>3.0.0.1</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CoreLib\CoreLib\CoreLib.csproj" />
		<ProjectReference Include="..\DataInterfaces\DataInterfaces\DataInterfaces.csproj" />
		<ProjectReference Include="..\Gizmo.Shared\Gizmo.Shared.csproj" />
		<ProjectReference Include="..\Gizmo.Shell\Gizmo.Shell\Gizmo.Shell.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="System.Management" />
		<Reference Include="System.ComponentModel.Composition" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Resources\Icons\battlenet.png" />
		<None Remove="Resources\Icons\cmd.png" />
		<None Remove="Resources\Icons\diablo3.png" />
		<None Remove="Resources\Icons\eadesktop.png" />
		<None Remove="Resources\Icons\epic.png" />
		<None Remove="Resources\Icons\instance.png" />
		<None Remove="Resources\Icons\minecraft.png" />
		<None Remove="Resources\Icons\origin.png" />
		<None Remove="Resources\Icons\process.png" />
		<None Remove="Resources\Icons\registry.png" />
		<None Remove="Resources\Icons\steam.png" />
		<None Remove="Resources\Icons\uplay.png" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\Icons\battlenet.png" />
		<EmbeddedResource Include="Resources\Icons\cmd.png" />
		<EmbeddedResource Include="Resources\Icons\diablo3.png" />
		<EmbeddedResource Include="Resources\Icons\eadesktop.png" />
		<EmbeddedResource Include="Resources\Icons\epic.png" />
		<EmbeddedResource Include="Resources\Icons\instance.png" />
		<EmbeddedResource Include="Resources\Icons\minecraft.png" />
		<EmbeddedResource Include="Resources\Icons\origin.png" />
		<EmbeddedResource Include="Resources\Icons\process.png" />
		<EmbeddedResource Include="Resources\Icons\registry.png" />
		<EmbeddedResource Include="Resources\Icons\steam.png" />
		<EmbeddedResource Include="Resources\Icons\uplay.png" />
		<EmbeddedResource Include="Resources\Icons\riot.png" />
		<EmbeddedResource Include="Resources\Icons\battlestate.png" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Resources\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	    <CustomToolNamespace>BaseLmPlugin.Autogenerated</CustomToolNamespace>
	  </EmbeddedResource>
	</ItemGroup>

	<Target Name="CleanPublishOutput" AfterTargets="Publish">
		<ItemGroup>
			<Files Include="$(PublishDir)*.pdb" />
			<Files Include="$(PublishDir)*.exe" />
			<Files Include="$(PublishDir)*.dll" />
			<Files Include="$(PublishDir)*.json" />
			<Files Include="$(PublishDir)*.xml" />
			<FilesToDelete Include="@(Files)" Condition="%(Filename) != 'BaseLmPlugin'" />
			<DirsToClean Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
		</ItemGroup>

		<!--remove leftorver pdb files-->
		<Delete Files="$(PublishDir)Gizmo.Client.UI.pdb;$(PublishDir)BaseLmPlugin.pdb" />
		<Delete Files="$(PublishDir)Gizmo.Client.UI.pdb;$(PublishDir)BaseLmPlugin.xml" />
		<!--delete files-->
		<Delete Files="@(FilesToDelete)" />
		<!--delete directories-->
		<RemoveDir Directories="@(DirsToClean)" />
	</Target>

</Project>